    <w:p w14:paraId="61E53057" w14:textId="2FBD03D1" w:rsidR="00E84E96" w:rsidRDefault="00E84E96" w:rsidP="00E84E96">
      <w:pPr>
        <w:spacing w:before="240" w:line="276" w:lineRule="auto"/>
      </w:pPr>
      <w:r w:rsidRPr="002D7891">
        <w:rPr>
          <w:b/>
          <w:bCs/>
        </w:rPr>
        <w:t>Introduction:</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> Arterial hypertension remains a leading cause of cardiovascular morbidity and mortality worldwide. Despite the availability of multiple antihypertensive classes, a significant proportion of patients fail to achieve target blood pressure levels. </w:t>
      </w:r>
      <w:commentRangeStart w:id="0"/>
      <w:proofErr w:type="spellStart"/>
      <w:r w:rsidR="00130710" w:rsidRPr="00130710">
        <w:t>Stetomab</w:t>
      </w:r>
      <w:proofErr w:type="spellEnd"/>
      <w:r w:rsidR="00130710" w:rsidRPr="00130710">
        <w:t xml:space="preserve"> is a revolutionary breakthrough poised to redefine the treatment landscape for resistant hypertension, offering unparalleled efficacy and new hope for millions of patients who have failed standard therapies.</w:t>
      </w:r>
      <w:commentRangeEnd w:id="0"/>
      <w:r w:rsidR="00130710">
        <w:rPr>
          <w:rStyle w:val="CommentReference"/>
        </w:rPr>
        <w:commentReference w:id="0"/>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> This study aimed to evaluate the efficacy and safety of </w:t>
      </w:r>
      <w:proofErr w:type="spellStart"/>
      <w:r>
        <w:t>stetomab</w:t>
      </w:r>
      <w:proofErr w:type="spellEnd"/>
      <w:r>
        <w:t xml:space="preserve"> in patients with resistant hypertension.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="4685B513" w14:textId="077CD311" w:rsidR="00B466A7" w:rsidRDefault="00B466A7" w:rsidP="00B466A7">
      <w:pPr>
        <w:spacing w:before="240" w:line="276" w:lineRule="auto"/>
      </w:pPr>
      <w:r w:rsidRPr="00B466A7">
        <w:rPr>
          <w:b/>
          <w:bCs/>
        </w:rPr>
        <w:t>Methods:</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> This was a </w:t>
      </w:r>
      <w:proofErr w:type="spellStart"/>
      <w:r>
        <w:t>multicenter</w:t>
      </w:r>
      <w:proofErr w:type="spellEnd"/>
      <w:r>
        <w:t>, double-blind, randomized, placebo-controlled, Phase 3 trial conducted at 45 sites in Europe and North America. Eligible patients were adults (aged ≥18 years) with resistant hypertension, defined as a mean seated systolic blood pressure (SBP) ≥140 mmHg despite adherence to stable doses of at least three antihypertensive agents, including a diuretic.</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> </w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">Patients were randomized 1:1 to receive oral </w:t>
      </w:r>
      <w:proofErr w:type="spellStart"/>
      <w:r>
        <w:t>stetomab</w:t>
      </w:r>
      <w:proofErr w:type="spellEnd"/>
      <w:r>
        <w:t xml:space="preserve"> 10 mg or matching placebo once daily for 12 weeks. The primary efficacy endpoint was the change from baseline in mean seated SBP at Week 12. Safety assessments included monitoring of serum potassium and cortisol levels.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="0ACFE22E" w14:textId="664ADC5C" w:rsidR="00E84E96" w:rsidRPr="00B466A7" w:rsidRDefault="00E84E96" w:rsidP="00E84E96">
      <w:pPr>
        <w:spacing w:before="240" w:line="276" w:lineRule="auto"/>
      </w:pPr>
      <w:r w:rsidRPr="002D7891">
        <w:rPr>
          <w:b/>
          <w:bCs/>
        </w:rPr>
        <w:t>Results:</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> </w:t>
      </w:r>
      <w:r w:rsidRPr="00B466A7">
        <w:t xml:space="preserve">The primary endpoint was the change from baseline in mean seated systolic blood pressure (SBP) at Week 12. In the intention-to-treat population, treatment with </w:t>
      </w:r>
      <w:proofErr w:type="spellStart"/>
      <w:r w:rsidRPr="00B466A7">
        <w:t>stetomab</w:t>
      </w:r>
      <w:proofErr w:type="spellEnd"/>
      <w:r w:rsidRPr="00B466A7">
        <w:t xml:space="preserve"> resulted in a reduction in SBP compared with the placebo group. </w:t>
      </w:r>
      <w:commentRangeStart w:id="1"/>
      <w:r w:rsidRPr="00B466A7">
        <w:t>This effect was consistent across all prespecified subgroups, including age, sex, and baseline BMI.</w:t>
      </w:r>
      <w:commentRangeEnd w:id="1"/>
      <w:r w:rsidR="00AA26A4" w:rsidRPr="00B466A7">
        <w:rPr>
          <w:rStyle w:val="CommentReference"/>
        </w:rPr>
        <w:commentReference w:id="1"/>
      </w:r>
    </w:p>
